COMPOSE_PROJECT_NAME=csrs_ent_preprod

DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ent.koba.sarl
DJANGO_CSRF_TRUSTED_ORIGINS=https://ent.koba.sarl
DJANGO_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
DJANGO_BIND_ADDRESS=127.0.0.1
DJANGO_PORT=18007
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_SESSION_AGE_SECONDS=28800
REDIS_URL=redis://redis:6379/0

ODOO_URL=http://127.0.0.1:18069
ODOO_EXTERNAL_BIND_ADDRESS=127.0.0.1
ODOO_EXTERNAL_PORT=18069
ODOO_DB_NAME=csrs_ent
ODOO_DB_USER=csrs_ent
ODOO_DB_PASSWORD=replace-with-generated-secret
ODOO_MASTER_PASSWORD=replace-with-generated-secret
ODOO_ADMIN_LOGIN=admin@ent.koba.sarl
ODOO_ADMIN_PASSWORD=replace-with-generated-secret

MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_PORT=18025
