COMPOSE_PROJECT_NAME=pent

DJANGO_SECRET_KEY=replace-with-a-random-django-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BIND_ADDRESS=127.0.0.1
DJANGO_PORT=18007

ODOO_URL=http://odoo:8069
ODOO_EXTERNAL_BIND_ADDRESS=127.0.0.1
ODOO_EXTERNAL_PORT=18069
ODOO_DB_NAME=pent_odoo
ODOO_DB_USER=pent_odoo
ODOO_DB_PASSWORD=replace-with-a-random-database-password
ODOO_MASTER_PASSWORD=replace-with-a-different-random-master-password
ODOO_ADMIN_LOGIN=admin@example.invalid
ODOO_ADMIN_PASSWORD=replace-with-a-third-random-admin-password
